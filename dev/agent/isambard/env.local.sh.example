# Copy to env.local.sh in this directory and fill in. env.local.sh is gitignored.
# It is sourced by submit.sh and agent_driver.slurm, so agent sessions see these
# as environment variables. Agents must never write the values into tracked files.

# --- SLURM ---------------------------------------------------------------------
export GLIDE_SLURM_ACCOUNT=""          # Isambard AI project code
export GLIDE_SLURM_PARTITION=""        # GPU partition
export GLIDE_AGENT_WALLTIME="24:00:00" # default allocation length

# --- Paths -----------------------------------------------------------------------
export GLIDE_REPO=""                   # absolute path of this checkout
export GLIDE_DATA=""                   # root of local met cubes (inventory in PROGRESS.md)
export GLIDE_AGENT_OUTPUTS=""          # run outputs, figures, long logs
export GLIDE_SCRATCH=""                # caches; uv and Triton caches go under here

# --- Restricted reference data (never copied into the repository) ----------------
export GLIDE_FLEXPART_SRC=""
export GLIDE_FLEXPART_OUTPUTS=""
export GLIDE_NAME_FOOTPRINTS=""
export GLIDE_EDGAR=""
export GLIDE_ETEX=""

# --- Agents ----------------------------------------------------------------------
export GLIDE_AGENT_MODEL_A="claude-fable-5-1"  # numerics and validation queue
export GLIDE_AGENT_MODEL_B="claude-sonnet-5"   # infrastructure queue
export GLIDE_AGENT_WAIT_SECONDS=1800           # pause between WAITING checks
export GLIDE_AGENT_MAX_TASKS=20                # sessions that deliver work, per allocation
